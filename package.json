{
  "name": "vms-enterprise",
  "version": "1.0.0",
  "description": "VMS Enterprise Architecture and Foundation",
  "main": "packages/types/src/index.ts",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts",
    "dev": "vite",
    "build:web": "vite build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 3000",
    "test:integration": "NODE_ENV=test tsx --test tests/integration/*.test.ts",
    "api:dev": "NODE_ENV=development tsx watch apps/api/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "db:migrate": "tsx packages/database/scripts/migrate.ts",
    "db:bootstrap-user": "tsx packages/database/scripts/bootstrap-user.ts"
  },
  "keywords": [
    "vms",
    "visitor-management",
    "contractor-management",
    "material-management",
    "esg",
    "ghg"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@types/node": "^26.6.4",
    "fastify": "^5.12.7",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}
