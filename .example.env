# ==============================================================================
# VMS ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTICE: This file contains environment variable placeholders only.
# NEVER commit production secrets, private keys, or credentials to version control.
# Copy this template to .env.<environment> (e.g. .env.local, .env.staging) for deployment.

# Environment Identification
NODE_ENV=development # Options: development | test | staging | production
APP_NAME=VMS-Enterprise
APP_PORT=3000
APP_BASE_URL=https://vms.corp.internal

# Multi-Tenant & SaaS Isolation
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
ENFORCE_STRICT_RLS=true

# Database Connection (PostgreSQL 16+)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vms_enterprise_db
DATABASE_USER=vms_app_user
DATABASE_PASSWORD=CHANGE_ME_IN_LOCAL_ENV_NEVER_IN_SOURCE
DATABASE_SSL=true
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# Secret Management & Cryptographic Keys
# In production, keys must be retrieved from Cloud KMS / HashiCorp Vault / AWS KMS
JWT_SECRET=PLACEHOLDER_MIN_32_CHAR_RANDOM_SECRET_KEY
JWT_EXPIRATION_SECONDS=3600 # 1 hour
JWT_REFRESH_EXPIRATION_SECONDS=604800 # 7 days
DATA_ENCRYPTION_KEY=PLACEHOLDER_BASE64_AES_256_GCM_ENCRYPTION_KEY
SESSION_SIGNING_SECRET=PLACEHOLDER_SESSION_HMAC_SECRET

# Key Management Service (KMS) Provider
KMS_PROVIDER=MOCK # Options: MOCK | AWS_KMS | GOOGLE_CLOUD_KMS | HASHICORP_VAULT
KMS_KEY_RING_ID=vms-enterprise-keyring
KMS_CRYPTO_KEY_ID=vms-sensitive-fields-key

# Authentication & Password Security Policies
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBERS=true
AUTH_PASSWORD_REQUIRE_SYMBOLS=true
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_SESSION_INACTIVITY_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_SESSION_TIMEOUT_HOURS=12

# Multi-Factor Authentication (MFA)
MFA_ENFORCED_FOR_ADMINS=true
MFA_TOTP_ISSUER=VMS-Enterprise-Security
MFA_CHALLENGE_TIMEOUT_SECONDS=300

# Enterprise Single Sign-On (SSO / OIDC / SAML)
SSO_ENABLED=false
SSO_PROVIDER=OIDC # Options: OIDC | SAML | OKTA | AZURE_AD
SSO_CLIENT_ID=PLACEHOLDER_SSO_CLIENT_ID
SSO_CLIENT_SECRET=PLACEHOLDER_SSO_CLIENT_SECRET
SSO_DISCOVERY_URL=https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration

# Document Storage & Signed Access (S3 / Cloud Storage / MinIO)
STORAGE_PROVIDER=LOCAL # Options: LOCAL | S3 | GCS | AZURE_BLOB
STORAGE_BUCKET_NAME=vms-enterprise-docs-vault
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=900 # 15 minutes max lifetime
STORAGE_MAX_FILE_SIZE_BYTES=26214400 # 25 MB max upload

# Rate Limiting & DoS Protection
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW_SECONDS=60
RATE_LIMIT_API_DEFAULT_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_EXPORT_MAX=10
RATE_LIMIT_EXPORT_WINDOW_SECONDS=300

# Web Security & CORS
CORS_ALLOWED_ORIGINS=https://app.vms.internal,https://admin.vms.internal
SECURITY_CSP_REPORT_ONLY=false
ENABLE_HSTS=true
